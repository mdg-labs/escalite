server {
    listen 5173;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Defer upstream DNS to request time (Coolify internal hostnames).
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /api/ {
        set $escalite_api_upstream "${ESCALITE_API_UPSTREAM}";
        proxy_pass $escalite_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /graphql {
        set $escalite_api_upstream "${ESCALITE_API_UPSTREAM}";
        proxy_pass $escalite_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Main app must not be embeddable in third-party frames (doc 07).
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
