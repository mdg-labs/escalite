{
  "name": "escalite",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "codegen": "turbo run codegen",
    "dev": "turbo run dev",
    "e2e": "turbo run e2e --filter=@escalite/web",
    "lint": "turbo run lint",
    "test": "turbo run test:unit",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.5.4"
  },
  "pnpm": {
    "overrides": {
      "@escalite/mobile>@types/react": "~18.3.31",
      "@escalite/mobile>react": "18.3.1",
      "@escalite/mobile>react-dom": "18.3.1",
      "@xmldom/xmldom": "^0.8.13",
      "brace-expansion@<=5.0.7": "^5.0.8",
      "immutable": "^4.3.9",
      "lodash": "^4.18.0",
      "postcss": "^8.5.18",
      "react-router": "^8.3.0",
      "tar": "^7.5.19"
    },
    "patchedDependencies": {
      "@expo/cli@0.22.28": "patches/@expo__cli@0.22.28.patch",
      "minimatch@3.1.5": "patches/minimatch@3.1.5.patch"
    }
  }
}
