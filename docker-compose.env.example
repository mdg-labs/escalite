# Escalite — set these variables in Coolify (or copy to .env for bare-metal docker compose).
# The compose file references ${VAR} placeholders only; no validation logic in docker-compose.yml.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
ESCALITE_ENCRYPTION_KEY=
POSTGRES_PASSWORD=change-me
ESCALITE_DATABASE_URL=postgres://escalite:change-me@postgres:5432/escalite?sslmode=disable
ESCALITE_APP_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# GHCR images (defaults match docker-compose.yml; pin a release tag for production)
# -----------------------------------------------------------------------------
# ESCALITE_API_IMAGE=ghcr.io/mdg-labs/escalite-api:latest
# ESCALITE_ENGINE_IMAGE=ghcr.io/mdg-labs/escalite-engine:latest
# ESCALITE_WEB_IMAGE=ghcr.io/mdg-labs/escalite-web:latest
# ESCALITE_STATUS_PAGE_IMAGE=ghcr.io/mdg-labs/escalite-status-page:latest
# ESCALITE_POSTGRES_IMAGE=postgres:16-alpine

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=escalite
POSTGRES_DB=escalite

# -----------------------------------------------------------------------------
# HTTP / logging
# -----------------------------------------------------------------------------
ESCALITE_LOG_LEVEL=info
ESCALITE_WEB_PORT=5173
ESCALITE_STATUS_PAGE_PORT=5174
ESCALITE_STATUS_PAGE_FRAME_ANCESTORS=*

# -----------------------------------------------------------------------------
# Optional OIDC
# -----------------------------------------------------------------------------
# ESCALITE_OIDC_ISSUER_URL=
# ESCALITE_OIDC_CLIENT_ID=
# ESCALITE_OIDC_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Optional SMTP (password reset and notifications)
# -----------------------------------------------------------------------------
# ESCALITE_SMTP_HOST=
# ESCALITE_SMTP_PORT=587
# ESCALITE_SMTP_USERNAME=
# ESCALITE_SMTP_PASSWORD=
# ESCALITE_SMTP_FROM=noreply@example.com

# -----------------------------------------------------------------------------
# Optional inbound email (email-to-alert)
# -----------------------------------------------------------------------------
# ESCALITE_INBOUND_EMAIL_RELAY_SECRET=
# ESCALITE_INBOUND_EMAIL_DOMAIN=inbound.example.com
# ESCALITE_INBOUND_EMAIL_REQUIRE_AUTHENTICATED=true

# -----------------------------------------------------------------------------
# Optional SMS/voice (Twilio)
# -----------------------------------------------------------------------------
# ESCALITE_SMS_PROVIDER=twilio
# ESCALITE_TWILIO_ACCOUNT_SID=
# ESCALITE_TWILIO_AUTH_TOKEN=
# ESCALITE_TWILIO_FROM_NUMBER=
# ESCALITE_TWILIO_VOICE_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Optional Slack app OAuth
# -----------------------------------------------------------------------------
# ESCALITE_SLACK_CLIENT_ID=
# ESCALITE_SLACK_CLIENT_SECRET=
# ESCALITE_SLACK_REDIRECT_URL=
# ESCALITE_SLACK_SCOPES=chat:write,chat:write.public,channels:read,users:read
# ESCALITE_SLACK_SIGNING_SECRET=
