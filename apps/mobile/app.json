{
  "expo": {
    "name": "Escalite",
    "slug": "escalite",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "escalite",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.mdglabs.escalite",
      "entitlements": {
        "com.apple.developer.usernotifications.critical-alerts": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0b"
      },
      "package": "dev.mdglabs.escalite",
      "permissions": [
        "android.permission.USE_FULL_SCREEN_INTENT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d70f7b7a-55e8-42a0-8f1d-980f7b072bfa"
      }
    },
    "owner": "mdg-labs"
  }
}
