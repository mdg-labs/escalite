# Escalite Docker Compose environment
# Copy to the repo root (for Task/migrations) and to deploy/docker-compose/.env for compose:
#   cp .env.example .env
#   cp .env.example deploy/docker-compose/.env

# -----------------------------------------------------------------------------
# Compose profiles
# -----------------------------------------------------------------------------
# Dev (hot reload):  docker compose --profile dev up
# Prod (local tags): task compose:prod:build && task compose:prod
# Release (registry): see deploy/docker-compose/README.md and docker-compose.release.yml
#
# Optional TLS reverse proxy: uncomment the `caddy` service in
# deploy/docker-compose/docker-compose.yml (see docs/specs/07-security-and-auth.md).

# Build target passed to service Dockerfiles (dev | prod). Compose sets this per profile.
ESCALITE_DOCKER_TARGET=dev

# -----------------------------------------------------------------------------
# PostgreSQL (compose `postgres` service)
# -----------------------------------------------------------------------------
POSTGRES_USER=escalite
POSTGRES_PASSWORD=escalite
POSTGRES_DB=escalite
POSTGRES_PORT=5432

# Connection string used by Go services inside the compose network.
ESCALITE_DATABASE_URL=postgres://escalite:escalite@postgres:5432/escalite?sslmode=disable

# -----------------------------------------------------------------------------
# Application secrets
# -----------------------------------------------------------------------------
# 32-byte key for AES-256-GCM encryption of provider credentials at rest (doc 07).
# Generate a value before first boot:
#   openssl rand -hex 32
ESCALITE_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# HTTP / logging (shared defaults; compose overrides per service where needed)
# -----------------------------------------------------------------------------
ESCALITE_LOG_LEVEL=info
ESCALITE_APP_ORIGIN=http://localhost:5173

# Host port mappings for compose services
ESCALITE_API_PORT=8080
ESCALITE_ENGINE_PORT=8081
ESCALITE_WEB_PORT=5173

# Per-service listen addresses inside containers
ESCALITE_API_HTTP_ADDR=:8080
ESCALITE_ENGINE_HTTP_ADDR=:8081

# -----------------------------------------------------------------------------
# Optional OIDC (disabled until auth task wires it)
# -----------------------------------------------------------------------------
# ESCALITE_OIDC_ISSUER_URL=
# ESCALITE_OIDC_CLIENT_ID=
# ESCALITE_OIDC_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Optional SMTP (password reset and notifications)
# -----------------------------------------------------------------------------
# When unset, password reset requests succeed but email is discarded (noop sender).
# ESCALITE_SMTP_HOST=
# ESCALITE_SMTP_PORT=587
# ESCALITE_SMTP_USERNAME=
# ESCALITE_SMTP_PASSWORD=
# ESCALITE_SMTP_FROM=noreply@example.com
# ESCALITE_PASSWORD_RESET_RATE_LIMIT_EMAIL=5
# ESCALITE_PASSWORD_RESET_RATE_LIMIT_EMAIL_WINDOW=1h
# ESCALITE_PASSWORD_RESET_RATE_LIMIT_IP=20
# ESCALITE_PASSWORD_RESET_RATE_LIMIT_IP_WINDOW=1h

# -----------------------------------------------------------------------------
# Optional inbound email (email-to-alert integration)
# -----------------------------------------------------------------------------
# Trusted SMTP relay forwards parsed JSON to POST /api/v1/inbound/email.
# Each email-to-alert IntegrationKey uses address: <token>@<domain>
# ESCALITE_INBOUND_EMAIL_RELAY_SECRET=
# ESCALITE_INBOUND_EMAIL_DOMAIN=inbound.escalite.local
# ESCALITE_INBOUND_EMAIL_REQUIRE_AUTHENTICATED=true

# -----------------------------------------------------------------------------
# Optional feature flags (env-based only per doc 08)
# -----------------------------------------------------------------------------
# ESCALITE_FEATURE_EXAMPLE=false

# -----------------------------------------------------------------------------
# Release image digests (docker-compose.release.yml — required for registry deploys)
# -----------------------------------------------------------------------------
# Pin to immutable @sha256:… after CI push. Resolve with:
#   docker buildx imagetools inspect ghcr.io/mdg-labs/escalite-api:TAG --format '{{.Manifest.Digest}}'
# ESCALITE_API_IMAGE=ghcr.io/mdg-labs/escalite-api@sha256:...
# ESCALITE_ENGINE_IMAGE=ghcr.io/mdg-labs/escalite-engine@sha256:...
# ESCALITE_WEB_IMAGE=ghcr.io/mdg-labs/escalite-web@sha256:...
# ESCALITE_POSTGRES_IMAGE=postgres:16-alpine@sha256:...

# -----------------------------------------------------------------------------
# Optional operator TLS / public URL (for Caddy or external reverse proxy)
# -----------------------------------------------------------------------------
# ESCALITE_PUBLIC_URL=https://escalite.example.com
